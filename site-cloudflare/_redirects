# www → 主域（统一到 payoncepdf.com，避免重复内容）
https://www.payoncepdf.com/*  https://payoncepdf.com/:splat  301

# 干净路径：四页各自独立 URL（参照 zhuazhua.video 的 / /download /pricing /help）
# 中文站
/download   /download.html  200
/pricing    /pricing.html   200
/help       /help.html      200

# 英文站（/en/ 下同样四页）
/en/            /en/index.html      200
/en/download    /en/download.html   200
/en/pricing     /en/pricing.html    200
/en/help        /en/help.html       200

# 旧路径兼容：单页时代的 index.en.html 与 #锚点入口，避免老链接 404
/index.en.html  /en/  301
/zh/            /     301

