{
  "name": "payoncepdf",
  "private": true,
  "version": "1.0.1",
  "description": "PayOnce PDF - a local PDF toolbox. No subscription, no account, no upload.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/rename-contract.test.mjs tests/selection-geometry.test.mjs tests/defect-regression.test.mjs tests/error-detail.test.mjs tests/trial-paywall.test.mjs tests/selfcheck-contract.test.mjs tests/site-contract.test.mjs tests/bundle-deps.test.mjs tests/opener-contract.test.mjs",
    "bundle:rename": "node scripts/rename-bundles.mjs",
    "site:check": "node scripts/deploy-cloudflare-site.mjs --check",
    "site:deploy": "node scripts/deploy-cloudflare-site.mjs --deploy",
    "site:verify": "node scripts/verify-cloudflare-site.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
